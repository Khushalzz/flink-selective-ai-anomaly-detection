# ==============================================================================
# Explicit Whitelist: Retain Essential Models, Processed Data & Results
# ==============================================================================
!models/*.onnx
!models/*.onnx.data
!models/*.json
!data/processed/*.parquet
!experiments/results/*
!assets/*
